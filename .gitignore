# ============================================================
# AI Evolution Intelligence
# Git Ignore Rules
# ============================================================

# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Environment / secrets
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Huge raw research datasets - keep external
data/raw/
data/raw/**

# Hugging Face cache - keep external/local
huggingface-cache/
.huggingface/
.cache/
.cache/huggingface/

# Large downloaded / temporary files
*.parquet
*.arrow
*.feather
*.zip
*.tar
*.tar.gz
*.7z
*.tmp
*.temp
*.incomplete

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3